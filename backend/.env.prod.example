# ==========================================
# STELARYS BACKEND - PRODUCTION ENVIRONMENT
# ==========================================
# Rename this file to .env or inject these variables into Cloud Run / Docker

# --- DJANGO CORE ---
# Set to 'False' in production
DJANGO_DEBUG=False
# Generate a strong, random secret key for production
DJANGO_SECRET_KEY=__CHANGE_ME_STRONG_SECRET__
# Comma-separated list of allowed hosts (e.g., your-app.run.app, api.stelarys.com)
ALLOWED_HOSTS=*
# Database URL (e.g., postgres://user:pass@host:port/dbname) - Required for production
DATABASE_URL=postgres://user:password@host:port/dbname

# --- EMAIL (SendGrid) ---
# Required for sending emails (auth, notifications)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxx
SENDGRID_SENDER=noreply@stelarys.com

# --- AI PROVIDER (Gemini / Vertex AI) ---
# Default: gemini_api (Free tier)
AI_PROVIDER=gemini_api
# Required if AI_PROVIDER=gemini_api
GEMINI_API_KEY=AIzaSy...

# Optional: Vertex AI Configuration (if AI_PROVIDER=vertex_ai)
# VERTEX_PROJECT_ID=your-gcp-project-id
# VERTEX_LOCATION=us-central1

# --- STORAGE (Google Cloud Storage) ---
# 'local' for development, 'gcs' for production
STORAGE_BACKEND=gcs
# Required if STORAGE_BACKEND=gcs
GCS_BUCKET_NAME=your-gcs-bucket-name

# --- ASYNC QUEUE (Cloud Tasks / Redis) ---
# 'thread' for local dev, 'cloud_tasks' for production (recommended for serverless)
QUEUE_BACKEND=cloud_tasks

# Cloud Tasks Config (Required if QUEUE_BACKEND=cloud_tasks)
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=us-central1
GCP_QUEUE=artifact-generation
# Secret header to secure internal task endpoints (must match valid X-CloudTasks-Secret header sent by Cloud Tasks)
CLOUD_TASKS_SECRET=__CHANGE_ME_RANDOM_STRING__

# Redis Config (Optional, usually for RQ/Worker based setups instead of Cloud Tasks)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# --- VECTOR DATABASE ---
# 'chroma' (local/sqlite) or 'pgvector' (production/postgres)
VECTOR_DB_BACKEND=pgvector

# --- BILLING (Google Play) ---
# Package name matching the app build
GOOGLE_PLAY_PACKAGE_NAME=com.stelarysllm.ia
# JSON content of the Service Account Key with Android Publisher API access
# IMPORTANT: This must be the full JSON string, not a path.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", ...}

# --- GUEST MODE ---
# Duration of guest trial in minutes (Default: 3 days = 4320)
GUEST_TRIAL_MINUTES=4320

# ==========================================
# FRONTEND VARIABLES (For Reference)
# ==========================================
# These are built into the Expo app. Set them in EAS Secrets or .env before build.
# EXPO_PUBLIC_API_URL=https://your-backend-url.run.app
